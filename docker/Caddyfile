{$GCM_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	# Only the MCP endpoint and the health check are exposed.
	@allowed path /mcp /healthz
	handle @allowed {
		reverse_proxy gcm:8787
	}
	handle {
		respond 404
	}
	log {
		output stdout
		format console
	}
}
