# Grok Context Manager — environment variables (all optional).
# Copy to .env only for Docker deployments; the CLI does not read .env files.

# Data folder. Default on Windows: %LOCALAPPDATA%\GrokContextManager
# GCM_HOME=D:\GCM\data

# --- Remote MCP deployment (docker/docker-compose.yml) ---
# Public hostname that Caddy obtains an HTTPS certificate for (DNS must point to the server).
GCM_DOMAIN=gcm.example.com
# Port the GCM container listens on inside the compose network (not published).
GCM_MCP_PORT=8787

# API tokens are NOT configured here. Create them inside the container so only hashes are stored:
#   docker compose run --rm gcm mcp token create --name sales-bot --bots sales --write
